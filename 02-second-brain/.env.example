# Claude API key (omit to run fully offline with heuristics)
ANTHROPIC_API_KEY=sk-ant-...
# Model override (default claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5
# Path to your Obsidian vault (default ./vault)
SECOND_BRAIN_VAULT=/absolute/path/to/vault
# Server-side refusal fallbacks (beta); set 0 to disable
SECOND_BRAIN_FALLBACKS=1
