# Claude API (or run `ant auth login`). Not needed for --dry-run.
ANTHROPIC_API_KEY=
# Default model for every agent without a per-agent `model` in roster.toml
CLAUDE_MODEL=claude-opus-5-5
# Second Brain (Obsidian) vault: knowledge tools read/write here and run reports are filed to <vault>/Agents/
VAULT_PATH=
# Webhook for send_message (Slack/Discord incoming webhook, n8n, Zapier...)
WORKFORCE_WEBHOOK_URL=
# Optional overrides
# WORKFORCE_ROSTER=./roster.toml
# WORKFORCE_WORKSPACE=./workspace
# WORKFORCE_RUNS_DIR=./runs
# WORKFORCE_KNOWLEDGE=local   # force the local markdown fallback instead of ../02-second-brain
