# Shared secrets for all five projects. Copy to .env (same folder) and fill in.
# Every project loads this file automatically; a project's own .env or a real
# environment variable wins over it. .env is gitignored — never commit it.

# --- Claude (https://console.anthropic.com/settings/keys) -------------------
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# --- Obsidian vault shared by all projects (create with: cd 02-second-brain && python -m second_brain init --vault ~/SecondBrain)
VAULT_PATH=

# --- Email app passwords (16-character app passwords, NOT your normal password)
# Referenced by password_env in connections.toml. Add one line per account.
GMAIL_APP_PASSWORD=
# ICLOUD_APP_PASSWORD=     # also used for iCloud calendars (incl. calendars shared with you)
# YAHOO_APP_PASSWORD=

# --- Outlook / Microsoft 365 email: Application (client) ID of your free Entra app registration
# OUTLOOK_CLIENT_ID=

# --- Tasks (optional) --------------------------------------------------------
# TODOIST_API_TOKEN=

# --- Notifications: morning briefing, check-in nudges, weekly reports and agent messages
# Telegram (recommended): token from @BotFather; then run
#   cd 01-life-dashboard && python -m life_dashboard telegram
# to find your chat id and send a test message.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Or a Slack / Discord incoming webhook (used when Telegram isn't set up)
NOTIFY_WEBHOOK_URL=
