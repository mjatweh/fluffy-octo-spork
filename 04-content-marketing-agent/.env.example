# Claude API key (omit to run in offline --dry-run mode)
ANTHROPIC_API_KEY=sk-ant-...
# Model override (default: claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5
# Effort: low | medium | high | xhigh | max (default: medium)
CLAUDE_EFFORT=medium
# Set to 0 to disable server-side refusal fallbacks
CLAUDE_FALLBACKS=1
# Brand directory (default: ./brand if filled in, else brand/examples)
BRAND_DIR=
# Output directory (default: ./output)
OUTPUT_DIR=
# Obsidian vault from project 02 — drafts are also saved to <vault>/Content/<type>/
VAULT_PATH=
