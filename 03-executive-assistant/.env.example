# Copy to .env (loaded automatically from the working directory; real env vars win).
ANTHROPIC_API_KEY=
# Default model is claude-opus-5-5
CLAUDE_MODEL=claude-opus-5-5
# Where the sqlite DB and weekly report files live (default ~/.exec_assistant)
EA_DATA_DIR=
# Obsidian vault from the Second Brain project; check-ins go to <vault>/Daily, rollups to <vault>/Weekly
VAULT_PATH=
# Optional webhook for nudges / weekly reports (Slack, Discord, Telegram sendMessage?chat_id=..., or any JSON endpoint)
EA_WEBHOOK_URL=
